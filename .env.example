# tb-brain — copy to .env (never commit .env)
# This box is a lab daily driver, not production. Keep LLM and Flow URLs in env
# so a GPU / hostname swap does not require code changes.

# --- LLM (OpenAI-compatible). Point at local Ollama; never a cloud LLM for client data.
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Leave empty to use Ollama's first listed model. Do not hardcode a size (14B/24B/32B).
LLM_MODEL=
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=180
AGENT_MAX_TOOL_ITERS=8

# --- tb-brain HTTP
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8765
# Lab actor recorded on every tool-call audit line.
BRAIN_ACTOR=lab-local

# Runtime files (logs). Must NOT be under OneDrive.
# Default: %LOCALAPPDATA%\tb-brain  (Windows) or ~/.local/share/tb-brain
# BRAIN_DATA_DIR=

# --- Flow (system of record). Phase 0 default is stub fixtures.
# stub = in-process fake data shaped like Flow models
# http = read-only Flow brain API (contacts / tickets / mail)
# db   = SELECT-only DB user (not wired until asked)
FLOW_MODE=stub
FLOW_BASE_URL=https://flow.techbldrs.com
# Do not put tokens here. On the host laptop only: FLOW_MODE=http and FLOW_API_TOKEN.
# FLOW_API_TOKEN=
# FLOW_DATABASE_URL=mysql+pymysql://brain_ro:***@127.0.0.1:3306/Ticket%20System

# --- Open WebUI (docker compose). Named volume stays in Docker's data root, not this repo.
# OPEN_WEBUI_PORT=3000
# Compose defaults: chat goes to tb-brain, not Ollama :11434.
# OPENAI_API_BASE_URL=http://host.docker.internal:8765/v1
# OPENAI_API_KEY=sk-tb-brain-lab
