# tb-brain — copy to .env (never commit .env)
# Keep LLM and source URLs in env so a GPU / hostname swap needs no code change. See README.md "Settings".

# --- LLM (OpenAI-compatible). Point at local Ollama; never a cloud LLM for client data.
LLM_BASE_URL=http://127.0.0.1:11434/v1
# The 5060 Ti box runs qwen2.5:14b-instruct (set OLLAMA_CONTEXT_LENGTH=16384 for Ollama; README "Runtime box notes").
# Leave empty to use Ollama's first listed model.
LLM_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=600
AGENT_MAX_TOOL_ITERS=8
# Pattern-matched answers that skip the LLM. Comma-separated names to turn OFF, so those
# questions go to the model instead (compare with scripts/eval.py before deleting any).
# Names: merge_suggestion, person_mail, person_ticket, tickets_about, longest_time
DISABLED_ROUTERS=
# qwen3:* models think before answering (about 9x slower here). true adds the /no_think switch to the system prompt.
LLM_NO_THINK=false
# JSON merged into every LLM request, e.g. {"reasoning_effort":"none"}. See scripts/probe_think.py.
LLM_EXTRA_BODY=
# legacy = the full Flow system prompt and tool schemas (default). lean = short general rules plus a section per
# enabled source, guidance in the tool descriptions, and the signed-in user and date after the cached prefix.
# Compare with scripts/eval.py and scripts/probe_cache.py before switching.
PROMPT_STYLE=legacy
# on: each model call gets only the sources the question needs (keywords, earlier in the chat, or the model's
# use_source request); Flow and search_knowledge always. off: every enabled source on every call. No effect
# while Flow is the only source.
SOURCE_ROUTING=on

# --- tb-brain HTTP
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8765
# Lab actor recorded on every tool-call audit line.
BRAIN_ACTOR=lab-local

# Runtime files (logs). Must NOT be under OneDrive.
# Default: %LOCALAPPDATA%\tb-brain  (Windows) or ~/.local/share/tb-brain
# BRAIN_DATA_DIR=

# --- Sources. Flow is always on; every other source is off unless its mode is set.
# Flow (system of record): stub = in-process fake data shaped like Flow models, http = read-only Flow brain API.
FLOW_MODE=stub
FLOW_BASE_URL=https://flow.techbldrs.com
# Never in this file or git. Only in the runtime box's .env: FLOW_MODE=http and FLOW_API_TOKEN.
# FLOW_API_TOKEN=
# Datto RMM: off | stub (fixtures for sites WDON, BUCK, NGMC) | http (the live API, read-only).
DATTO_MODE=off
# DATTO_API_URL=https://vidal-api.centrastage.net
# Never in this file or git. Only in the runtime box's .env, for tb-brain's own read-only Datto API user
# (not Flow's): DATTO_API_KEY and DATTO_API_SECRET.
# DATTO_API_KEY=
# DATTO_API_SECRET=
# Microsoft 365 via GDAP (Phase C): reserved until that source exists.
M365_MODE=off

# --- Open WebUI (docker compose). Named volume stays in Docker's data root, not this repo.
# OPEN_WEBUI_PORT=3000
# Compose defaults: chat goes to tb-brain, not Ollama :11434.
# OPENAI_API_BASE_URL=http://host.docker.internal:8765/v1
# OPENAI_API_KEY=sk-tb-brain-lab

# --- Knowledge (search_knowledge: IT Glue SOPs + past fix notes).
# Empty QDRANT_URL disables the tool gracefully. docker compose up -d starts
# Qdrant on 127.0.0.1:6333 (see docker-compose.yml).
# QDRANT_URL=http://127.0.0.1:6333
KNOWLEDGE_COLLECTION=tb_knowledge
# Local embedding model via LLM_BASE_URL/LLM_API_KEY above. ollama pull nomic-embed-text first.
EMBEDDING_MODEL=nomic-embed-text
