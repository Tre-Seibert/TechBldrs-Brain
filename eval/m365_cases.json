      "expect": [
        {
          "tool": "m365_users",
          "args": {
            "client_code": "WDON",
            "view": "count"
          }
        }
      ],
      "must_match": [
        "(?i)12 accounts"
      ],
      "sources": [
        "m365"
      ],
      "note": "12 accounts: 8 enabled, 4 disabled (3 shared mailboxes and Jenna Brooks), 7 licensed; counted in code."
