{
  "description": "tb-brain eval set. Expected answers assume FLOW_MODE=stub fixtures (app/flow/fixtures.py).",
  "cases": [
    {
      "id": "lt-basic",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "Which open ticket has the longest time worked"
        }
      ],
      "must_contain": [
        "ZTST-0091",
        "ZTST-0092"
      ],
      "must_not_contain": [
        "ZTST-0006"
      ]
    },
    {
      "id": "lt-word-order",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "What's the longest ticket worked?"
        }
      ],
      "must_contain": [
        "ZTST-0091"
      ],
      "must_not_contain": [
        "ZTST-0006"
      ]
    },
    {
      "id": "lt-most-hours",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "Which ticket has the most hours?"
        }
      ],
      "must_contain": [
        "ZTST-0091"
      ],
      "must_not_contain": [
        "ZTST-0006"
      ]
    },
    {
      "id": "lt-highest-logged",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "Highest hours logged on an open ticket?"
        }
      ],
      "must_contain": [
        "ZTST-0091"
      ],
      "must_not_contain": [
        "ZTST-0006"
      ]
    },
    {
      "id": "lt-single",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "Just the one ticket with the most hours, please."
        }
      ],
      "must_contain": [
        "ZTST-0091"
      ],
      "must_not_contain": [
        "ZTST-0092",
        "ZTST-0006"
      ],
      "note": "Explicit count of one must return one ticket."
    },
    {
      "id": "lt-top3",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "Top 3 open tickets by longest time worked"
        }
      ],
      "must_contain": [
        "ZTST-0091",
        "ZTST-0092",
        "ZTST-0093"
      ],
      "must_not_contain": [
        "WDON-1842",
        "ZTST-0006"
      ]
    },
    {
      "id": "lt-not-placeholder",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "Which open ticket has the longest time worked that isn't a placeholder ticket"
        }
      ],
      "must_contain": [
        "ZTST-0091"
      ],
      "must_not_contain": [
        "ZTST-0006"
      ]
    },
    {
      "id": "lt-follow-up",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "Which open ticket has the longest time worked"
        },
        {
          "role": "assistant",
          "content": "Top 5 open tickets, ranked by longest time worked:\n- ZTST-0091 Server migration project (42.0 hrs)\n- ZTST-0092 Firewall replacement (18.5 hrs)\n- ZTST-0093 Office move network setup (6.25 hrs)\n- WDON-1842 Imaging workstation offline (0.75 hrs)\n- ACME-0041 VPN dropouts (0.5 hrs)"
        },
        {
          "role": "user",
          "content": "How about after that?"
        }
      ],
      "must_match": [
        "(?i)(no (more|other|further|additional)|can't rank|cannot rank|nothing (left|else)|already)"
      ],
      "must_not_contain": [
        "ZTST-0006"
      ],
      "note": "Every ticket with hours was already shown; must say nothing is left, not repeat or invent."
    },
    {
      "id": "lt-not-this",
      "group": "longest_time",
      "messages": [
        {
          "role": "user",
          "content": "How much time was logged on ticket ACME-0041?"
        }
      ],
      "must_contain": [
        "ACME-0041"
      ],
      "must_not_contain": [
        "ZTST-0091"
      ],
      "note": "Time on one named ticket is not a ranking question."
    },
